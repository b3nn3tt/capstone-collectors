NESSUS_BASE_URL=https://127.0.0.1:8834
NESSUS_ACCESS_KEY=
NESSUS_SECRET_KEY=
NESSUS_VERIFY_TLS=true
NESSUS_CONNECT_TIMEOUT_SECONDS=5
NESSUS_READ_TIMEOUT_SECONDS=15

# Optional export settings. Every one has the documented default shown below,
# so leaving these commented out — or absent from an existing .env — is fine.
# NESSUS_EXPORT_POLL_INTERVAL_SECONDS=2
# NESSUS_EXPORT_POLL_TIMEOUT_SECONDS=600
# NESSUS_EXPORT_MAX_BYTES=1073741824
